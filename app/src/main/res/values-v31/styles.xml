<resources>

    <!-- ═══════════════════════════════════════════════════════════════
         Splash Screen Theme for Android 12+ (API 31+)
         Uses the new SplashScreen API with animated icon
         ═══════════════════════════════════════════════════════════════ -->
    
    <style name="SplashScreenTheme" parent="Theme.SplashScreen">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@color/splash_bg_start</item>
        <item name="android:navigationBarColor">@color/splash_bg_end</item>
        
        <!-- Splash Screen specific attributes -->
        <item name="windowSplashScreenBackground">@color/splash_bg_start</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>

</resources>
