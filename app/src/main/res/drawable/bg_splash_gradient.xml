<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="160"
                android:startColor="#0A5C2B"
                android:centerColor="#0D7A38"
                android:endColor="#16A34A" />
        </shape>
    </item>
    <!-- Subtle radial glow overlay -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="600dp"
                android:centerX="50%"
                android:centerY="35%"
                android:startColor="#1522C55E"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
