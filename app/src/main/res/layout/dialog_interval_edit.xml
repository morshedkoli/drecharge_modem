<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <!-- ── Header (always visible, never scrolls) ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_gradient_header"
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:gravity="center">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="App Settings"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:letterSpacing="0.02"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Interval · Theme · Exit"
            android:textSize="12sp"
            android:textColor="?attr/colorTealLight"
            android:gravity="center"
            android:layout_marginTop="4dp"/>

    </LinearLayout>

    <!-- ── Scrollable body (interval + theme cards) ── -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="false"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- ─ Request Interval section ─ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <View
                    android:layout_width="3dp"
                    android:layout_height="16dp"
                    android:background="?attr/colorPrimary"
                    android:layout_marginEnd="10dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Request Interval"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:textColor="?attr/colorOnSurface"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <EditText
                    android:id="@+id/dialogIntervalEt"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:hint="30"
                    android:inputType="number"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:textColor="?attr/colorOnSurface"
                    android:textColorHint="?attr/colorTextHint"
                    android:background="@drawable/bg_rounded_input"
                    android:layout_marginEnd="10dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="seconds"
                    android:textSize="13sp"
                    android:textColor="?attr/colorTextSecondary"/>

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Default: 30s · Minimum: 5s"
                android:textSize="11sp"
                android:textColor="?attr/colorTextHint"
                android:layout_marginBottom="20dp"/>

            <!-- ─ Divider ─ -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?attr/colorDivider"
                android:layout_marginBottom="20dp"/>

            <!-- ─ App Theme section ─ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <View
                    android:layout_width="3dp"
                    android:layout_height="16dp"
                    android:background="?attr/colorPrimary"
                    android:layout_marginEnd="10dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="App Theme"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:textColor="?attr/colorOnSurface"/>

            </LinearLayout>

            <RadioGroup
                android:id="@+id/themeRadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Theme 1: Cyber Dark -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardNeonDark"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp"
                    app:cardBackgroundColor="#0B0F1A">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="12dp">

                        <RadioButton
                            android:id="@+id/rbNeonDark"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:buttonTint="#00D4FF"
                            android:layout_marginEnd="10dp"/>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginEnd="12dp">
                            <View android:layout_width="14dp" android:layout_height="28dp" android:background="#0B0F1A"/>
                            <View android:layout_width="14dp" android:layout_height="28dp" android:background="#00D4FF"/>
                            <View android:layout_width="14dp" android:layout_height="28dp" android:background="#4F46E5"/>
                            <View android:layout_width="14dp" android:layout_height="28dp" android:background="#22C55E"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Cyber Dark"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Dark UI · Neon cyan"
                                android:textSize="10sp"
                                android:textColor="#94A3B8"
                                android:layout_marginTop="1dp"/>
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Theme 2: Cash Green -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardBankingGreen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp"
                    app:cardBackgroundColor="#F8FAFC">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="12dp">

                        <RadioButton
                            android:id="@+id/rbBankingGreen"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:buttonTint="#16A34A"
                            android:layout_marginEnd="10dp"/>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginEnd="12dp">
                            <View android:layout_width="14dp" android:layout_height="28dp" android:background="#16A34A"/>
                            <View android:layout_width="14dp" android:layout_height="28dp" android:background="#22C55E"/>
                            <View android:layout_width="14dp" android:layout_height="28dp" android:background="#DCFCE7"/>
                            <View android:layout_width="14dp" android:layout_height="28dp" android:background="#F8FAFC"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Cash Green"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="#0F172A"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Light UI · bKash &amp; Nagad vibe"
                                android:textSize="10sp"
                                android:textColor="#475569"
                                android:layout_marginTop="1dp"/>
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Theme 3: Indigo Pro -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardIndigoPro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp"
                    app:cardBackgroundColor="#0F172A">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="12dp">

                        <RadioButton
                            android:id="@+id/rbIndigoPro"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:buttonTint="#4F46E5"
                            android:layout_marginEnd="10dp"/>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginEnd="12dp">
                            <View android:layout_width="14dp" android:layout_height="28dp" android:background="#4F46E5"/>
                            <View android:layout_width="14dp" android:layout_height="28dp" android:background="#3B82F6"/>
                            <View android:layout_width="14dp" android:layout_height="28dp" android:background="#00D4FF"/>
                            <View android:layout_width="14dp" android:layout_height="28dp" android:background="#0F172A"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Indigo Pro"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="#E2E8F0"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Dark UI · Stripe &amp; PayPal style"
                                android:textSize="10sp"
                                android:textColor="#94A3B8"
                                android:layout_marginTop="1dp"/>
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Theme 4: Soft White -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSoftWhite"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E8EDF2"
                    app:cardBackgroundColor="#FAFAFA">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="12dp">

                        <RadioButton
                            android:id="@+id/rbSoftWhite"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:buttonTint="#0284C7"
                            android:layout_marginEnd="10dp"/>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginEnd="12dp">
                            <View android:layout_width="14dp" android:layout_height="28dp" android:background="#FAFAFA"/>
                            <View android:layout_width="14dp" android:layout_height="28dp" android:background="#FFFFFF"/>
                            <View android:layout_width="14dp" android:layout_height="28dp" android:background="#0284C7"/>
                            <View android:layout_width="14dp" android:layout_height="28dp" android:background="#38BDF8"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Soft White"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="#0C1A2E"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Light UI · Pure white · Sky blue"
                                android:textSize="10sp"
                                android:textColor="#4A5568"
                                android:layout_marginTop="1dp"/>
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Theme 5: Pearl Rose -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPearlRose"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#FAE8EF"
                    app:cardBackgroundColor="#FFF5F7">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="12dp">

                        <RadioButton
                            android:id="@+id/rbPearlRose"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:buttonTint="#E11D48"
                            android:layout_marginEnd="10dp"/>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginEnd="12dp">
                            <View android:layout_width="14dp" android:layout_height="28dp" android:background="#FFF5F7"/>
                            <View android:layout_width="14dp" android:layout_height="28dp" android:background="#FCE7EF"/>
                            <View android:layout_width="14dp" android:layout_height="28dp" android:background="#E11D48"/>
                            <View android:layout_width="14dp" android:layout_height="28dp" android:background="#FB7185"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Pearl Rose"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="#1A0510"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Warm cream · Rose accent"
                                android:textSize="10sp"
                                android:textColor="#6B4655"
                                android:layout_marginTop="1dp"/>
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </RadioGroup>

        </LinearLayout>
    </ScrollView>

    <!-- ── Buttons (always visible, never scrolls) ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorDivider"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/dialogIntervalSaveBtn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Save Settings"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_confirm"
            android:layout_marginBottom="10dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"/>

        <Button
            android:id="@+id/dialogExitAppBtn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Exit App"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_cancel"
            android:insetTop="0dp"
            android:insetBottom="0dp"/>

    </LinearLayout>

</LinearLayout>
