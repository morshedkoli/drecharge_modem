<resources>

    <!-- ═══════════════════════════════════════════════════════════════
         dRecharge Theme System - 3 Themes Available
         1. Neon Dark - Modern banking + crypto style
         2. Banking Green - Trusted banking (bKash/Nagad vibe)
         3. Indigo Pro - Stripe/PayPal style
         ═══════════════════════════════════════════════════════════════ -->

    <!-- Base Theme (Legacy - maps to Banking Green) -->
    <style name="AppTheme" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/bg_screen</item>
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
        <item name="elevationOverlayEnabled">true</item>
        <item name="actionMenuTextColor">@android:color/white</item>
        <item name="android:actionMenuTextColor">@android:color/white</item>
        <item name="colorControlNormal">@android:color/white</item>
        <item name="android:textColorPrimary">@android:color/white</item>
        <!-- Custom dynamic color attrs (defaults to Banking Green palette) -->
        <item name="colorTextSecondary">@color/text_secondary</item>
        <item name="colorTextHint">@color/text_hint</item>
        <item name="colorDivider">@color/divider</item>
        <item name="colorLogText">@color/log_text</item>
        <item name="colorInactiveGrey">@color/inactive_grey</item>
        <item name="colorInactiveBg">@color/inactive_bg</item>
        <item name="colorTealLight">@color/teal_light</item>
        <item name="colorActiveGreen">@color/active_green</item>
        <item name="colorActiveBg">@color/active_bg</item>
        <item name="colorHeaderStart">@color/header_start</item>
        <item name="colorHeaderEnd">@color/header_end</item>
    </style>

